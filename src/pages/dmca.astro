---
import { localeHelpers } from '../i18n/index';
const { t } = localeHelpers(Astro.url);

import { site, countryText } from "../../countries/site.mjs";
import Layout from "../layouts/Layout.astro";
import SEO from "../components/SEO.astro";

const siteRoot = site.siteUrl;
const canonical = `${siteRoot}/dmca/`;
const pageTitle = countryText(`DMCA | ${site.siteName}`);
const pageDescription = countryText(`Digital Millennium Copyright Act (DMCA) policy for ${site.siteName}.`);

const structuredData = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": `${canonical}#dmca`,
  name: pageTitle,
  url: canonical,
  description: pageDescription,
};
---

<Layout title={t(pageTitle)} description={pageDescription}>
  <SEO slot="seo" title={t(pageTitle)} description={pageDescription} canonical={canonical} ogTitle={pageTitle} ogDescription={pageDescription} ogImage={new URL(site.socialImage, siteRoot).href} robots="index, follow" author={site.siteName} structuredData={structuredData} />
  <div class="mb-4">
    <h1 class="display-5 fw-bold mb-2">{t("DMCA")}</h1>
    <h2 class="lead text-muted">{t("Digital Millennium Copyright Act")}</h2>
  </div>
  <div class="bg-white border rounded-3 p-4">
    <p> {t("{0} is a portal of music streaming directory that is available through the internet. Here we provide many worldwide internet radio and music stations to listen freely with various genres. {1} does not broadcast any streaming content and copyright information, except station information and their official website links. We focus on making it easier for listeners who are looking for appropriate stations. We are always ready to help broadcasters and listeners. Our hope is to give internet radio stations a portal to worldwide listeners.", [site.siteName, site.siteName])} </p>
    <p> {t("{0} takes matters of Intellectual Property very seriously and is committed to meeting the needs of content owners while helping them manage publication of their content online. It should be noted that {1} is a radio station portal linking to third-party websites. Any content on these third-party websites is the responsibility of those sites and not {2}. We have no knowledge of whether content on third-party websites is or is not authorized by the content owner as that is a matter between the site that hosts the audio content and the content owner. {3} does not host any audio content on its servers or network.", [site.siteName, site.siteName, site.siteName, site.siteName])} </p>
    <p> {t("{0} is not the owner of the media streaming and the copyright or ownership of any radio station remains with the broadcaster. Users must agree with the terms and conditions of the station owners. We respect the broadcaster's privacy policy. If you are the content owner of any radio station and want removal from this site, please contact us.", [site.siteName])} </p>
  </div>
</Layout>
