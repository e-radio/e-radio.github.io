---
import Layout from '../../layouts/Layout.astro';
import SEO from '../../components/SEO.astro';
import { localeHelpers } from '../../i18n/index';
import { site } from '../../../countries/site.mjs';
const { t } = localeHelpers(Astro.url);
const title = t('PLS playlist viewer');
const description = t('View a PLS playlist file and find the stream URLs inside it.');
---
<Layout title={title} description={description}>
  <SEO slot="seo" title={title} description={description} canonical={site.siteUrl + Astro.url.pathname} />
  <section class="py-4 mx-auto" style="max-width: 850px">
    <h1>{title}</h1>
    <p class="lead">{description}</p>
    <p class="text-muted">{t('Requests run in your browser. If direct access fails, the playlist is fetched through Tunzilla.')}</p>
    <form id="pls-form" class="glass rounded-3 p-4">
      <label for="pls-url" class="form-label">{t('PLS URL')}</label>
      <input id="pls-url" class="form-control" type="url" required placeholder="http://s5.onweb.gr:8506/listen.pls" />
      <button id="pls-submit" class="btn btn-primary mt-3" type="submit">{t('View playlist')}</button>
    </form>
    <p id="pls-status" class="mt-3" role="status" aria-live="polite"></p>
    <div id="pls-results" hidden>
      <h2 class="h4">{t('Stream URLs')}</h2>
      <ul id="pls-streams" class="list-group mb-4"></ul>
      <label for="pls-content" class="h4 d-block">{t('Playlist content')}</label>
      <textarea id="pls-content" class="form-control font-monospace small" rows="12" readonly></textarea>
    </div>
  </section>
</Layout>
<script>
  import { parsePlsPlaylist } from '../../lib/pls-playlist.mjs';
  import { clientTranslate as t } from '../../i18n/translate';

  const form = document.querySelector<HTMLFormElement>('#pls-form')!;
  const input = document.querySelector<HTMLInputElement>('#pls-url')!;
  const submit = document.querySelector<HTMLButtonElement>('#pls-submit')!;
  const status = document.querySelector<HTMLElement>('#pls-status')!;
  const results = document.querySelector<HTMLElement>('#pls-results')!;
  const streams = document.querySelector<HTMLElement>('#pls-streams')!;
  const content = document.querySelector<HTMLTextAreaElement>('#pls-content')!;

  async function readPlaylist(response: Response) {
    if (!response.ok) throw new Error(`HTTP ${response.status}`);
    const reader = response.body?.getReader();
    if (!reader) throw new Error('Empty response');
    const decoder = new TextDecoder();
    let text = '';
    let bytes = 0;
    try {
      while (true) {
        const { done, value } = await reader.read();
        if (done) break;
        bytes += value.byteLength;
        if (bytes > 65536) throw new Error('Playlist too large');
        text += decoder.decode(value, { stream: true });
      }
      return text + decoder.decode();
    } finally { reader.cancel().catch(() => {}); }
  }

  form.addEventListener('submit', async event => {
    event.preventDefault();
    results.hidden = true;
    streams.replaceChildren();
    let url: URL;
    try {
      url = new URL(input.value.trim());
      if (!['http:', 'https:'].includes(url.protocol)) throw new Error('Invalid URL');
    } catch { status.textContent = t('Enter a valid HTTP or HTTPS playlist URL.'); return; }
    submit.disabled = true;
    status.textContent = t('Loading playlist…');
    const candidates = url.protocol === 'https:' ? [url.href, `https://a.tunzilla.com/${url.href}`] : [`https://a.tunzilla.com/${url.href}`];
    try {
      let raw = '';
      let lastError: unknown;
      for (const candidate of candidates) {
        try {
          raw = await readPlaylist(await fetch(candidate, { cache: 'no-store', signal: AbortSignal.timeout(10000) }));
          break;
        } catch (error) { lastError = error; }
      }
      if (!raw) throw lastError || new Error('Empty playlist');
      const entries = parsePlsPlaylist(raw);
      content.value = raw;
      for (const entry of entries) {
        const item = document.createElement('li');
        item.className = 'list-group-item';
        if (entry.title) {
          const name = document.createElement('strong');
          name.className = 'd-block';
          name.textContent = entry.title;
          item.append(name);
        }
        const link = document.createElement('a');
        link.href = entry.url;
        link.textContent = entry.url;
        link.className = 'text-break';
        link.target = '_blank';
        link.rel = 'noopener noreferrer';
        item.append(link);
        streams.append(item);
      }
      results.hidden = false;
      status.textContent = entries.length ? t('Found {0} stream URL(s).', [entries.length]) : t('No stream URLs found in this playlist.');
    } catch { status.textContent = t('Could not load the playlist. Check the URL or try again later.'); }
    finally { submit.disabled = false; }
  });
</script>
