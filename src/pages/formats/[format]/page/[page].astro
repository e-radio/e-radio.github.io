---
import FormatStations from '../../../../components/FormatStations.astro';
import { formatEntries, FORMAT_PAGE_SIZE } from '../../../../lib/station-formats';
export function getStaticPaths() {
 return formatEntries.flatMap(entry => Array.from({length:Math.max(0, Math.ceil(entry.stations.length / FORMAT_PAGE_SIZE)-1)}, (_,index) => ({
  params:{format:entry.slug, page:String(index+2)}, props:{entry, page:index+2}
 })));
}
const {entry, page} = Astro.props;
---
<FormatStations entry={entry} page={page} />
