---
import { localeHelpers } from '../i18n/index';
const { t, localizePath } = localeHelpers(Astro.url);

import { site, countryText } from "../../countries/site.mjs";
import Layout from "../layouts/Layout.astro";
import SEO from "../components/SEO.astro";
import CategorySwitch from "../components/CategorySwitch.astro";
import rawStations from "../lib/stations";
import { slugify } from "../lib/slug";
import { Image } from "astro:assets";

const radddioURL = "https://apple.co/4lNPQAH";
const radioAppIconUrl = "/radddio-app-icon.png";
const radddioBadgeUrl = "/radddio-badge.svg";
const ogImage = site.socialImage;

const HIGH_BITRATE_THRESHOLD = 320;
const highQualityStations = rawStations
  .filter((station) => Number(station.bitrate || 0) >= HIGH_BITRATE_THRESHOLD)
  .sort((a, b) => (b.bitrate || 0) - (a.bitrate || 0));

const PAGE_SIZE = 20;
const page = 1;
const totalStations = highQualityStations.length;
const totalPages = Math.ceil(totalStations / PAGE_SIZE);
const startIndex = (page - 1) * PAGE_SIZE;
const endIndex = startIndex + PAGE_SIZE;
const pagedStations = highQualityStations.slice(startIndex, endIndex);

const siteRoot = site.siteUrl;
const canonical = `${siteRoot}/high-quality/`;
const pageTitle = countryText(`High Quality (320 kbps) Greek Radio Streams | ${site.siteShortName}`);
const pageDescription = countryText(`Listen to ${totalStations} Greek radio streams broadcasting in 320 kbps or higher for premium sound, clearer vocals, and richer music across popular stations.`);
const ogImageUrl = new URL(ogImage, siteRoot).href;

const structuredData = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "@id": `${canonical}#collection`,
  name: pageTitle,
  url: canonical,
  description: pageDescription,
  image: ogImageUrl,
};
---

<Layout title={t(pageTitle)} description={pageDescription}>
  <SEO slot="seo" title={t(pageTitle)} description={pageDescription} canonical={canonical} ogTitle={pageTitle} ogDescription={pageDescription} ogImage={ogImageUrl} keywords={`high quality radio, 320 kbps radio streams, ${site.countryAdjective} radio`} robots="index, follow" author={site.siteName} structuredData={structuredData} />
  <div class="mb-4">
    <h1 class="display-5 fw-bold mb-2">{t("{0} High Quality Radio Streams", [site.countryAdjective])}</h1>
    <h2 class="lead text-muted">{t("Only stations broadcasting at 320 kbps or higher.")}</h2>
    <p class="text-muted small">{t("Found {0} high-bitrate station{1}.", [totalStations, totalStations === 1 ? "" : "s"])}</p>
    {totalPages > 1 && (
      <p class="text-muted small">{t("Showing stations {0}–{1} of {2}", [startIndex + 1, Math.min(endIndex, totalStations), totalStations])}</p>
    )}
  </div>
  <CategorySwitch current="high-quality" />
  {totalStations === 0 ? (
    <div class="alert alert-warning" role="status"> {t("No stations currently meet the 320 kbps threshold.")} </div>
  ) : (
    <div class="station-list border border-light-subtle rounded-3 overflow-hidden">
      {pagedStations.map((station, index) => (
        <div class={`station-item position-relative ${index !== pagedStations.length - 1 ? 'border-bottom border-light-subtle' : ''}`} itemscope itemtype="https://schema.org/RadioStation">
          <a href={localizePath(`/stations/${station.slug}/`)} class="stretched-link" aria-label={t(`Go to ${station.name}`)} itemprop="url" />
          <div class="station-item-body p-3">
            <div class="row align-items-center g-3">
              <div class="col-auto">
                {station.favicon ? (
                  <Image src={station.favicon} alt={t(`${station.name} logo`)} class="rounded station-logo" width={60} height={60} itemprop="image" />
                ) : (
                  <Image src={radioAppIconUrl} alt={t("Radddio app icon")} class="rounded station-logo" width={60} height={60} itemprop="image" />
                )}
              </div>
              <div class="col flex-grow-1">
                <h3 class="mb-1 fs-6 fw-bold text-dark" itemprop="name">{station.name}</h3>
                <p class="small text-muted mb-1">
                  {station.state ? <span itemprop="addressLocality"><i class="bi bi-geo-alt me-1" aria-hidden="true" />{t(station.state)}</span> : null}
                  <span class="ms-2"><i class="bi bi-soundwave me-1" aria-hidden="true" />{t("{0} kbps", [station.bitrate])}</span>
                  {station.codec ? <span class="ms-2"><i class="bi bi-file-music me-1" aria-hidden="true" />{t(String(station.codec).toUpperCase())}</span> : null}
                </p>
                <div class="d-flex gap-2 flex-wrap">
                  {station.genres && station.genres.slice(0, 3).map((genre) => (
                    <a href={localizePath(`/genres/${slugify(genre)}/`)} class="badge bg-secondary-subtle text-secondary-emphasis rounded-pill text-decoration-none genre-badge-link">{t(genre)}</a>
                  ))}
                </div>
              </div>
              <div class="col-auto text-end d-md-block">
                <a href={localizePath(radddioURL)} class="text-decoration-none radddio-badge" target="_blank" rel="nofollow noopener" aria-label={t(`Listen to ${station.name} on Radddio App`)}><Image src={radddioBadgeUrl} alt={t("Radddio app badge")} width={144} height={47} /></a>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
  )}
  {totalPages > 1 && (
    <nav aria-label={t("High quality pagination")} class="mt-5">
      <ul class="pagination justify-content-center">
        <li class={`page-item ${page === 1 ? 'disabled' : ''}`}>
          <a class="page-link" href={localizePath(page > 1 ? (page - 1 === 1 ? '/high-quality/' : `/high-quality/page/${page - 1}/`) : '/high-quality/')}> {t("Previous")} </a>
        </li>
        {Array.from({ length: totalPages }, (_, i) => i + 1).map((pageNum) => (
          <li class={`page-item ${pageNum === page ? 'active' : ''}`}>
            <a class="page-link" href={localizePath(pageNum === 1 ? '/high-quality/' : `/high-quality/page/${pageNum}/`)}>{t(pageNum)}</a>
          </li>
        ))}
        <li class={`page-item ${page === totalPages ? 'disabled' : ''}`}>
          <a class="page-link" href={localizePath(page < totalPages ? `/high-quality/page/${page + 1}/` : (page === 1 ? '/high-quality/' : `/high-quality/page/${page}/`))}> {t("Next")} </a>
        </li>
      </ul>
    </nav>
  )}
</Layout>
