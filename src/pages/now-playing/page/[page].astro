---
import NowPlayingStations from "../../../components/NowPlayingStations.astro";
import { metadataStations, METADATA_PAGE_SIZE } from "../../../lib/metadata-stations";

export function getStaticPaths() {
  const pages = Math.ceil(metadataStations.length / METADATA_PAGE_SIZE);
  return Array.from({ length: Math.max(0, pages - 1) }, (_, index) => ({
    params: { page: String(index + 2) },
    props: { page: index + 2 },
  }));
}
const { page } = Astro.props;
---
<NowPlayingStations page={page} />
