---
import Layout from '../layouts/Layout.astro';
import SEO from '../components/SEO.astro';
import CategorySwitch from '../components/CategorySwitch.astro';
import rawStations from '../data/stations-gr.json';
import metadataConfig from '../data/metadata-config.json';
const endpointFor = (station: typeof rawStations[number]) => {
  const mode = (station as typeof station & { metadata_mode?: string }).metadata_mode || metadataConfig.mode;
  const endpoint = station.nowplaying_url!;
  const direct = endpoint.replace(/^https:\/\/r\.jina\.ai\//i, '');
  return mode === 'jina' || (mode === 'auto' && ['centovacast', 'icecast'].includes(station.metadata_server || '') && !direct.startsWith('https://'))
    ? `https://r.jina.ai/${direct}` : direct;
};
const stations = rawStations.filter(s => ['azuracast', 'centovacast', 'radiojar', 'icecast'].includes(s.metadata_server || '') && s.nowplaying_url && s.stream_url)
  .sort((a,b) => a.name.localeCompare(b.name));
const stationCount = (server: string) => stations.filter(station => station.metadata_server === server).length;
const title = 'Live Tracks — Now Playing on Greek Radio | E-Radio';
const description = 'Discover what is playing right now on AzuraCast, CentovaCast, Radiojar, and Icecast radio stations. Browse songs, artists, and stations, and listen live.';
---
<Layout title={title} description={description}>
  <SEO slot="seo" title={title} description={description} canonical="https://e-radio.github.io/live-tracks/" />
  <h1 class="display-5 fw-bold mb-2">Live Tracks</h1>
  <p class="lead text-muted">What’s playing right now across {stationCount('azuracast')} AzuraCast, {stationCount('centovacast')} CentovaCast, {stationCount('radiojar')} Radiojar, and {stationCount('icecast')} Icecast stations.</p>
  <CategorySwitch current="live-tracks" />
    <div class="d-flex align-items-center flex-nowrap gap-2 mb-2">
        <h2 class="h6 mb-0">On Air</h2><span class="badge rounded-pill badge-soft-green">Live</span>
    </div>
  <div class="live-track-list">
    {stations.map(station => (
      <article class="live-track p-2 px-3" data-server={station.metadata_server} data-endpoint={endpointFor(station)} data-stream={station.stream_url} data-name={station.name}>
        <img class="track-cover rounded" src={station.favicon || '/radddio-app-icon.png'} data-fallback={station.favicon || '/radddio-app-icon.png'} alt={`${station.name} cover artwork`} width="60" height="60" loading="lazy" />
        <div class="track-copy">
          <h3 class="track-title h6 fw-semibold mb-0">Loading song…</h3>
          <p class="text-muted mb-0"><span class="track-artist"></span><a href={`/stations/${station.slug}/`} class="text-reset">{station.name}</a>{station.city ? ` · ${station.city}` : ''}</p>
          <span class={`badge rounded-pill me-2 ${station.metadata_server === 'azuracast' ? 'bg-primary-subtle text-primary-emphasis' : 'bg-success-subtle text-success-emphasis'}`}>{station.metadata_server === 'azuracast' ? 'AzuraCast' : station.metadata_server === 'radiojar' ? 'Radiojar' : station.metadata_server === 'icecast' ? 'Icecast' : 'CentovaCast'}</span>
          <span class="track-listeners small text-muted"></span>
          <span class="track-status small text-muted" role="status"></span>
        </div>
        <button class="track-play btn rounded-circle" type="button" aria-label={`Play ${station.name}`}><i class="bi bi-play-fill" aria-hidden="true"></i></button>
      </article>
    ))}
  </div>
  <div id="live-metadata-config" data-poll={metadataConfig.pollIntervalMs} data-timeout={metadataConfig.requestTimeoutMs} hidden></div>
  <audio id="live-tracks-audio" preload="none"></audio>
</Layout>
<script>
  import { icecastTrack } from '../lib/icecast.mjs';
  import { radiojarSong } from '../lib/radiojar.mjs';
  const settings = document.querySelector<HTMLElement>('#live-metadata-config')!;
  const pollInterval = Math.max(5000, Number(settings.dataset.poll) || 15000);
  const requestTimeout = Math.max(1000, Number(settings.dataset.timeout) || 10000);
  const cards = [...document.querySelectorAll<HTMLElement>('.live-track')];
  const audio = document.querySelector<HTMLAudioElement>('#live-tracks-audio')!;
  let active: HTMLElement | null = null;
  let requestId = 0;
  const resetButton = (card: HTMLElement) => {
    card.querySelector('button')!.setAttribute('aria-label', `Play ${card.dataset.name}`);
    card.querySelector('button i')!.className = 'bi bi-play-fill';
  };
  cards.forEach(card => {
    const cover = card.querySelector<HTMLImageElement>('img')!;
    cover.addEventListener('error', () => {
      const fallback = new URL(cover.dataset.fallback!, location.href).href;
      if (cover.src !== fallback) cover.src = fallback;
    });
    card.querySelector('button')!.addEventListener('click', async () => {
      const currentRequest = ++requestId;
      const previous = active;
      audio.pause();
      if (previous) { resetButton(previous); previous.querySelector('.track-status')!.textContent = ''; }
      if (previous === card) { active = null; return; }
      active = card;
      card.querySelector('button')!.setAttribute('aria-label', `Stop ${card.dataset.name}`);
      card.querySelector('button i')!.className = 'bi bi-stop-fill';
      card.querySelector('.track-status')!.textContent = 'Connecting…';
      audio.src = card.dataset.stream!.replace(/^http:\/\//, 'https://');
      try {
        await audio.play();
        if (currentRequest === requestId) card.querySelector('.track-status')!.textContent = '';
      } catch {
        if (currentRequest !== requestId) return;
        card.querySelector('.track-status')!.textContent = 'Unable to play. Open the station for more options.';
        resetButton(card); active = null;
      }
    });
  });
  audio.addEventListener('error', () => {
    if (!active) return;
    active.querySelector('.track-status')!.textContent = 'Stream unavailable.';
    resetButton(active); active = null;
  });
  audio.addEventListener('ended', () => { if (active) resetButton(active); active = null; });
  const groups = new Map<string, HTMLElement[]>();
  cards.forEach(card => {
    const endpoint = card.dataset.endpoint!;
    groups.set(endpoint, [...(groups.get(endpoint) || []), card]);
  });
  let refreshing = false;
  let timer: ReturnType<typeof setTimeout>;
  async function refresh() {
    clearTimeout(timer);
    if (document.hidden || refreshing) return;
    refreshing = true;
    const queue = [...groups.entries()];
    async function worker() {
      while (queue.length && !document.hidden) {
        const [endpoint, entries] = queue.shift()!;
        try {
          const response = await fetch(endpoint, { signal: AbortSignal.timeout(requestTimeout) });
          if (!response.ok) throw new Error(String(response.status));
          const text = await response.text();
          const raw = text.includes('Markdown Content:') ? text.split('Markdown Content:').slice(1).join('Markdown Content:').trim() : text;
          const data = JSON.parse(raw);
          if (data?.type === 'error') throw new Error('Metadata unavailable');
          for (const card of entries) {
            const centova = card.dataset.server === 'centovacast' && Array.isArray(data?.data) ? data.data[0] : null;
            const source = centova?.track;
            const icecast = card.dataset.server === 'icecast' ? icecastTrack(data, card.dataset.stream, endpoint) : null;
            const song = card.dataset.server === 'icecast' ? icecast : card.dataset.server === 'radiojar' ? radiojarSong(data) : centova ? { title: source?.title, artist: source?.artist, text: centova.song, art: source?.imageurl || source?.image } : data?.now_playing?.song;
            const listenersEl = card.querySelector<HTMLElement>('.track-listeners')!;
            const count = icecast?.listeners ?? data?.listeners?.current ?? centova?.listeners ?? centova?.listenertotal;
            const hasCount = typeof count === 'number' && Number.isInteger(count) && count >= 0;
            listenersEl.textContent = hasCount ? `${count.toLocaleString()} ${count === 1 ? 'listener' : 'listeners'}` : '';
            listenersEl.hidden = !hasCount;
            card.querySelector('.track-title')!.textContent = song?.title || song?.text || 'Song information unavailable';
            card.querySelector('.track-artist')!.textContent = song?.artist ? `${song.artist} · ` : '';
            const cover = card.querySelector<HTMLImageElement>('img')!;
            let artwork = cover.dataset.fallback!;
            try {
              const url = new URL(song?.art);
              if (url.protocol === 'https:') artwork = url.href;
            } catch { /* Missing artwork uses the station logo. */ }
            if (cover.src !== new URL(artwork, location.href).href) cover.src = artwork;
            cover.alt = artwork === cover.dataset.fallback ? `${card.dataset.name} logo` : `${song?.title || 'Current song'} cover artwork`;
            card.dataset.loaded = 'true';
            card.querySelector('.track-title')!.removeAttribute('title');
          }
        } catch {
          entries.forEach(card => {
            if (!card.dataset.loaded) card.querySelector('.track-title')!.textContent = 'Song information unavailable';
            card.querySelector('.track-title')!.setAttribute('title', 'Metadata could not be refreshed. Retrying shortly.');
          });
        }
      }
    }
    try { await Promise.all(Array.from({ length: 6 }, worker)); }
    finally {
      refreshing = false;
      if (!document.hidden) timer = setTimeout(refresh, pollInterval);
    }
  }
  document.addEventListener('visibilitychange', () => { clearTimeout(timer); if (!document.hidden) refresh(); });
  refresh();
</script>

