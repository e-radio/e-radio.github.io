---
import { localeHelpers } from '../i18n/index';
const { t, localizePath } = localeHelpers(Astro.url);

import { site, countryText } from "../../countries/site.mjs";
import Layout from '../layouts/Layout.astro';
import SEO from '../components/SEO.astro';
import CategorySwitch from '../components/CategorySwitch.astro';
import rawStations from "../lib/stations";
import metadataConfig from '../data/metadata-config.json';
const endpointFor = (station: typeof rawStations[number]) => {
  const mode = (station as typeof station & { metadata_mode?: string }).metadata_mode || metadataConfig.mode;
  const endpoint = station.nowplaying_url!;
  const direct = endpoint.replace(/^https:\/\/r\.jina\.ai\//i, '');
  return mode === 'jina' || (mode === 'auto' && ['centovacast', 'icecast', 'shoutcast'].includes(station.metadata_server || '') && !direct.startsWith('https://'))
    ? `https://r.jina.ai/${direct}` : direct;
};
const stations = rawStations.filter(s => ['azuracast', 'centovacast', 'radiojar', 'icecast', 'otvoreni', 'shoutcast'].includes(s.metadata_server || '') && s.nowplaying_url && s.stream_url)
  .sort((a,b) => a.name.localeCompare(b.name));
const stationCount = (server: string) => stations.filter(station => station.metadata_server === server).length;
const title = countryText(`Live Tracks — Now Playing on Greek Radio | ${site.siteShortName}`);
const description = 'Discover what is playing right now on AzuraCast, CentovaCast, Radiojar, Icecast, Otvoreni, and Shoutcast radio stations. Browse songs, artists, and stations, and listen live.';
---

<Layout title={t(title)} description={t(description)}>
  <SEO slot="seo" title={t(title)} description={t(description)} canonical={site.siteUrl + "/live-tracks/"} />
  <h1 class="display-5 fw-bold mb-2">{t("Live Tracks")}</h1>
  <p class="lead text-muted">{t("What’s playing right now across {0} AzuraCast, {1} CentovaCast, {2} Radiojar, {3} Icecast, {4} Otvoreni, and {5} Shoutcast stations.", [stationCount('azuracast'), stationCount('centovacast'), stationCount('radiojar'), stationCount('icecast'), stationCount('otvoreni'), stationCount('shoutcast')])}</p>
  <CategorySwitch current="live-tracks" />
    <div class="d-flex align-items-center flex-nowrap gap-2 mb-2">
        <h2 class="h6 mb-0">{t("On Air")}</h2><span class="badge rounded-pill badge-soft-green">{t("Live")}</span>
    </div>
  <div class="live-track-list">
    {stations.map(station => (
      <article class="live-track p-2 px-3" data-server={station.metadata_server} data-endpoint={endpointFor(station)} data-stream={station.stream_url} data-name={station.name}>
        <img class="track-cover rounded" src={station.favicon || '/radddio-app-icon.png'} data-fallback={station.favicon || '/radddio-app-icon.png'} alt={t(`${station.name} cover artwork`)} width="60" height="60" loading="lazy" />
        <div class="track-copy">
          <h3 class="track-title h6 fw-semibold mb-0">{t("Loading song…")}</h3>
          <p class="text-muted mb-0"><span class="track-artist" /><a href={localizePath(`/stations/${station.slug}/`)} class="text-reset">{station.name}</a>{t(station.city ? ` · ${station.city}` : '')}</p>
          <span class={`badge rounded-pill me-2 ${station.metadata_server === 'azuracast' ? 'bg-primary-subtle text-primary-emphasis' : 'bg-success-subtle text-success-emphasis'}`}>{t(station.metadata_server === 'azuracast' ? 'AzuraCast' : station.metadata_server === 'radiojar' ? 'Radiojar' : station.metadata_server === 'icecast' ? 'Icecast' : 'CentovaCast')}</span>
          <span class="track-listeners small text-muted" />
          <span class="track-status small text-muted" role="status" />
        </div>
        <button class="track-play btn rounded-circle" type="button" aria-label={t(`Play ${station.name}`)}><i class="bi bi-play-fill" aria-hidden="true" /></button>
      </article>
    ))}
  </div>
  <div id="live-metadata-config" data-poll={metadataConfig.pollIntervalMs} data-timeout={metadataConfig.requestTimeoutMs} hidden />
  <audio id="live-tracks-audio" preload="none" />
</Layout>
<script>
  import { parseMetadata, decodeMetadata } from '../lib/metadata/index.mjs';
import { clientTranslate as t } from '../i18n/translate';

  import { updateTrackText, trackArtworkController } from '../lib/live-track-view.mjs';
  import { createMetadataFetcher } from '../lib/metadata-fetch.mjs';
  import { metadataPollDelay } from '../lib/metadata-polling.mjs';


  const settings = document.querySelector<HTMLElement>('#live-metadata-config')!;
  const pollInterval = Math.max(5000, Number(settings.dataset.poll) || 15000);
  const requestTimeout = Math.max(1000, Number(settings.dataset.timeout) || 10000);
  const cards = [...document.querySelectorAll<HTMLElement>('.live-track')];
  const audio = document.querySelector<HTMLAudioElement>('#live-tracks-audio')!;
  let active: HTMLElement | null = null;
  let requestId = 0;
  const resetButton = (card: HTMLElement) => {
    card.querySelector('button')!.setAttribute('aria-label', t(`Play ${card.dataset.name}`));
    card.querySelector('button i')!.className = 'bi bi-play-fill';
  };
  const artworkControllers = new Map<HTMLElement, ReturnType<typeof trackArtworkController>>();
  cards.forEach(card => {
    const cover = card.querySelector<HTMLImageElement>('img')!;
    artworkControllers.set(card, trackArtworkController(cover, cover.dataset.fallback!, location.href));
    card.querySelector('button')!.addEventListener('click', async () => {
      const currentRequest = ++requestId;
      const previous = active;
      audio.pause();
      if (previous) { resetButton(previous); previous.querySelector('.track-status')!.textContent = ''; }
      if (previous === card) { active = null; return; }
      active = card;
      card.querySelector('button')!.setAttribute('aria-label', t(`Stop ${card.dataset.name}`));
      card.querySelector('button i')!.className = 'bi bi-stop-fill';
      card.querySelector('.track-status')!.textContent = t('Connecting…');
      audio.src = card.dataset.stream!;
      try {
        await audio.play();
        if (currentRequest === requestId) card.querySelector('.track-status')!.textContent = '';
      } catch {
        if (currentRequest !== requestId) return;
        card.querySelector('.track-status')!.textContent = t('Unable to play. Open the station for more options.');
        resetButton(card); active = null;
      }
    });
  });
  audio.addEventListener('error', () => {
    if (!active) return;
    active.querySelector('.track-status')!.textContent = t('Stream unavailable.');
    resetButton(active); active = null;
  });
  audio.addEventListener('ended', () => { if (active) resetButton(active); active = null; });
  const groups = new Map<string, HTMLElement[]>();
  cards.forEach(card => {
    const endpoint = card.dataset.endpoint!;
    groups.set(endpoint, [...(groups.get(endpoint) || []), card]);
  });
  const metadataFetcher = createMetadataFetcher({ timeout: requestTimeout });
  const nextRefresh = new Map<string, number>();
  let refreshing = false;
  let timer: ReturnType<typeof setTimeout>;
  async function refresh() {
    clearTimeout(timer);
    if (document.hidden || refreshing) return;
    refreshing = true;
    const queue = [...groups.entries()].filter(([endpoint]) => !metadataFetcher.isBlocked(endpoint) && (nextRefresh.get(endpoint) || 0) <= Date.now());
    async function worker() {
      while (queue.length && !document.hidden) {
        const [endpoint, entries] = queue.shift()!;
        try {
          const data = await metadataFetcher.request(endpoint, decodeMetadata);
          const delay = Math.min(...entries.map(card => metadataPollDelay(card.dataset.server, data, pollInterval)));
          nextRefresh.set(endpoint, Date.now() + delay);
          for (const card of entries) {
            const parsed = parseMetadata(card.dataset.server, data, { streamUrl: card.dataset.stream, endpoint });
            const song = parsed.song;
            const listenersEl = card.querySelector<HTMLElement>('.track-listeners')!;
            const count = parsed.listeners;
            const hasCount = typeof count === 'number' && Number.isInteger(count) && count >= 0;
            updateTrackText(listenersEl, hasCount ? `${count.toLocaleString()} ${count === 1 ? 'listener' : 'listeners'}` : '');
            listenersEl.hidden = !hasCount;
            updateTrackText(card.querySelector('.track-title'), song?.title || song?.text || t('Song information unavailable'));
            updateTrackText(card.querySelector('.track-artist'), song?.artist ? `${song.artist} · ` : '');
            const cover = card.querySelector<HTMLImageElement>('img')!;
            const usesFallback = artworkControllers.get(card)!(song?.art);
            const alt = usesFallback ? t(`${card.dataset.name} logo`) : t(`${song?.title || 'Current song'} cover artwork`);
            if (cover.alt !== alt) cover.alt = alt;
            card.dataset.loaded = 'true';
            card.querySelector('.track-title')!.removeAttribute('title');
          }
        } catch {
          nextRefresh.set(endpoint, Date.now() + pollInterval);
          entries.forEach(card => {
            if (!card.dataset.loaded) updateTrackText(card.querySelector('.track-title'), t('Song information unavailable'));
            card.querySelector('.track-title')!.setAttribute('title', t('Song information unavailable'));
          });
        }
      }
    }
    try { await Promise.all(Array.from({ length: 6 }, worker)); }
    finally {
      refreshing = false;
      if (!document.hidden && groups.size) {
        const pending = [...groups.keys()].filter(endpoint => !metadataFetcher.isBlocked(endpoint));
        const due = Math.min(...pending.map(endpoint => nextRefresh.get(endpoint) || 0));
        if (pending.length) timer = setTimeout(refresh, Math.max(0, due - Date.now()));
      }
    }
  }
  document.addEventListener('visibilitychange', () => { clearTimeout(timer); if (!document.hidden) refresh(); });
  refresh();
</script>

