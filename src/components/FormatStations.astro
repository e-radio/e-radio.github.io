---
import Layout from '../layouts/Layout.astro';
import SEO from './SEO.astro';
import CategorySwitch from './CategorySwitch.astro';
import { Image } from 'astro:assets';
import { site } from '../../countries/site.mjs';
import { localeHelpers } from '../i18n/index';
import { formatEntries, FORMAT_PAGE_SIZE } from '../lib/station-formats';
interface Props { entry: (typeof formatEntries)[number]; page?: number; }
const { entry, page = 1 } = Astro.props;
const { t, localizePath } = localeHelpers(Astro.url);
const { slug, stations } = entry;
const totalStations = stations.length;
const totalPages = Math.ceil(totalStations / FORMAT_PAGE_SIZE);
const startIndex = (page - 1) * FORMAT_PAGE_SIZE;
const endIndex = startIndex + FORMAT_PAGE_SIZE;
const pagedStations = stations.slice(startIndex, endIndex);
const pagePath = (number: number) => number === 1 ? `/formats/${slug}/` : `/formats/${slug}/page/${number}/`;
const canonical = new URL(pagePath(page), site.siteUrl).href;
const pageTitle = `${t(entry.name)} | ${t('Radio formats')}${page > 1 ? t(' – Page {0}', [page]) : ''} | ${site.siteShortName}`;
const pageDescription = `${t('Browse stations by programme format, language, era and listening mood.')} ${t(entry.name)}. ${t('Page {0} of {1}. Showing stations {2}–{3} of {4}.', [page, totalPages, startIndex + 1, Math.min(endIndex, totalStations), totalStations])}`;
const ogImageUrl = new URL(site.socialImage, site.siteUrl).href;
const radddioURL = 'https://apple.co/4lNPQAH';
const radioAppIconUrl = '/radddio-app-icon.png';
const radddioBadgeUrl = '/radddio-badge.svg';
const structuredData = {
 '@context':'https://schema.org', '@type':'CollectionPage', '@id':`${canonical}#collection`,
 name:pageTitle, description:pageDescription, url:canonical, image:ogImageUrl,
 mainEntity:{'@type':'ItemList', numberOfItems:pagedStations.length, itemListElement:pagedStations.map((station,index)=>({
  '@type':'ListItem', position:startIndex+index+1, name:station.name, url:`${site.siteUrl}/stations/${station.slug}/`
 }))}
};
---

<Layout title={t(pageTitle)} description={pageDescription}>
  <SEO slot="seo" title={t(pageTitle)} description={pageDescription} canonical={canonical} ogTitle={pageTitle} ogDescription={pageDescription} ogImage={ogImageUrl} robots="index, follow" author={site.siteName} structuredData={structuredData} prevUrl={page > 1 ? new URL(pagePath(page - 1), site.siteUrl).href : undefined} nextUrl={page < totalPages ? new URL(pagePath(page + 1), site.siteUrl).href : undefined} />
  <div class="mb-4">
    <h1 class="display-6 fw-bold mb-2">{t("{0} Stations", [entry.name])}</h1>
    <h2 class="lead text-muted">{t("Browse {0} station{1} in {2}.", [stations.length, stations.length === 1 ? "" : "s", entry.name])}</h2>
    {totalPages > 1 && (
      <p class="text-muted small mt-2">{t("Showing stations {0}–{1} of {2}", [startIndex + 1, Math.min(endIndex, totalStations), totalStations])}</p>
    )}
    <p class="small text-muted mb-2"><a href={localizePath("/formats/")}>{t("← Back to formats")}</a></p>
  </div>
  <CategorySwitch current="formats" />
  <section class="mt-4">
    <div class="station-list border border-light-subtle rounded-3 overflow-hidden">
      {pagedStations.map((station, index) => (
        <div class={`station-item position-relative ${index !== pagedStations.length - 1 ? 'border-bottom border-light-subtle' : ''}`} itemscope itemtype="https://schema.org/RadioStation">
          <a href={localizePath(`/stations/${station.slug}/`)} class="stretched-link" aria-label={t(`Go to ${station.name}`)} itemprop="url" />
          <div class="station-item-body p-3">
            <div class="row align-items-center g-3">
              <div class="col-auto">
                {station.favicon ? (
                  <Image src={station.favicon} alt={t(`${station.name} logo`)} class="rounded station-logo" loading="lazy" decoding="async" fetchpriority="low" width={60} height={60} itemprop="image" />
                ) : (
                  <Image src={radioAppIconUrl} alt={t("Radddio app icon")} class="rounded station-logo" loading="lazy" decoding="async" fetchpriority="low" width={60} height={60} itemprop="image" />
                )}
              </div>
              <div class="col flex-grow-1">
                <h3 class="mb-1 fs-6 fw-bold text-dark" itemprop="name">{station.name}</h3>
                <p class="small text-muted mb-1">
                  {station.state ? <span itemprop="addressLocality"><i class="bi bi-geo-alt me-1" aria-hidden="true" />{t(station.state)}</span> : null}
                  {station.bitrate ? <span class="ms-2"><i class="bi bi-soundwave me-1" aria-hidden="true" />{t("{0} kbps", [station.bitrate])}</span> : null}
                </p>
              </div>
              <div class="col-auto text-end d-md-block">
                <a href={localizePath(radddioURL)} class="text-decoration-none radddio-badge" target="_blank" rel="nofollow noopener" aria-label={t(`Listen to ${station.name} on Radddio App`)}><Image src={radddioBadgeUrl} alt={t("Radddio app badge")} width={144} height={47} loading="lazy" decoding="async" fetchpriority="low" /></a>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>
  {totalPages > 1 && (
    <nav aria-label={t("Format pagination")} class="mt-5">
      <ul class="pagination justify-content-center">
        <li class={`page-item ${page === 1 ? 'disabled' : ''}`}>
          <a class="page-link" href={localizePath(page > 1 ? (page - 1 === 1 ? `/formats/${slug}/` : `/formats/${slug}/page/${page - 1}/`) : `/formats/${slug}/`)}> {t("Previous")} </a>
        </li>
        {Array.from({ length: totalPages }, (_, i) => i + 1).map((pageNum) => (
          <li class={`page-item ${pageNum === page ? 'active' : ''}`}>
            <a class="page-link" aria-current={pageNum === page ? "page" : undefined} href={localizePath(pageNum === 1 ? `/formats/${slug}/` : `/formats/${slug}/page/${pageNum}/`)}>{t(pageNum)}</a>
          </li>
        ))}
        <li class={`page-item ${page === totalPages ? 'disabled' : ''}`}>
          <a class="page-link" href={localizePath(page < totalPages ? `/formats/${slug}/page/${page + 1}/` : (page === 1 ? `/formats/${slug}/` : `/formats/${slug}/page/${page}/`))}> {t("Next")} </a>
        </li>
      </ul>
    </nav>
  )}
</Layout>
