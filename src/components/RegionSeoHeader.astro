---
import { localeHelpers } from '../i18n/index';
const { t, localizePath } = localeHelpers(Astro.url);

interface Props {
  heading: string;
  subtitle: string;
  introduction: string;
  rangeLabel: string;
  backHref?: string;
  backLabel?: string;
}

const {
  heading,
  subtitle,
  introduction,
  rangeLabel,
  backHref = "/region/",
  backLabel = "Back to regions",
} = Astro.props;
---

<div class="mb-4">
  <h1 class="display-5 fw-bold mb-2">{t(heading)}</h1>
  <h2 class="lead text-muted">{t(subtitle)}</h2>
  <p class="text-muted mt-3">{t(introduction)}</p>
  <p class="text-muted small mt-2">{t(rangeLabel)}</p>
  <p class="small text-muted mb-2"><a href={localizePath(backHref)}>{t("← {0}", [backLabel])}</a></p>
</div>
