{
  "name": "astro",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "git push gr": "git add . && git commit -m \"update\" && git push origin main",
    "git push hr": "git add . && git commit -m \"update\" && git push croatia main",
    "find metadata": "node tools/find-station-metadata-endpoints.mjs --write",
    "fill state": "python3 tools/fill-state-from-homepage.py --max 0 --sleep 1",
    "fff brobe": "python3 tools/ffprobe-metadata.py --url https://radio.streamings.gr/proxy/yellownewstream?mp=/stream",
    "get stations from radio browser api": "node tools/fetch-greece-stations.mjs",
    "helper": "node tools/find-station-metadata-endpoints.mjs --write",
    "check": "astro check",
    "stations:import": "node tools/fetch-greece-stations.mjs",
    "stations:metadata": "node tools/find-station-metadata-endpoints.mjs --write",
    "stations:icons": "node tools/cache-station-favicons.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "astro": "^5.17.3",
    "bootstrap": "^5.3.8",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^26.4.1",
    "typescript": "^5.9.3"
  }
}
